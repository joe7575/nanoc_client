{
  "name": "nanoc-debug",
  "displayName": "NanoC Debugger",
  "description": "Debug NanoC controllers (in Luanti/Minetest) via the nanoc-dap adapter.",
  "version": "0.4.0",
  "publisher": "joe7575",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebugResolve:nanoc",
    "onLanguage:nanoc",
    "onCommand:nanoc.upload",
    "onCommand:nanoc.download",
    "onCommand:nanoc.check",
    "onCommand:nanoc.openTerminal"
  ],
  "main": "./extension.js",
  "contributes": {
    "configurationDefaults": {
      "debug.allowBreakpointsEverywhere": true
    },
    "commands": [
      {
        "command": "nanoc.upload",
        "title": "Upload Program to Controller",
        "category": "NanoC"
      },
      {
        "command": "nanoc.download",
        "title": "Download Program from Controller",
        "category": "NanoC"
      },
      {
        "command": "nanoc.check",
        "title": "Check Program (lint)",
        "category": "NanoC"
      },
      {
        "command": "nanoc.openTerminal",
        "title": "Open Terminal (nanoc-tui)",
        "category": "NanoC"
      }
    ],
    "keybindings": [
      {
        "command": "nanoc.upload",
        "key": "ctrl+alt+u",
        "when": "debugType == nanoc"
      },
      {
        "command": "nanoc.openTerminal",
        "key": "ctrl+alt+t",
        "when": "debugType == nanoc"
      }
    ],
    "configuration": {
      "title": "NanoC",
      "properties": {
        "nanoc.dapPath": {
          "type": "string",
          "default": "",
          "description": "Path to the nanoc-dap executable. Leave empty to auto-detect."
        },
        "nanoc.checkPath": {
          "type": "string",
          "default": "",
          "description": "Path to the nanoc-check linter executable. Leave empty to auto-detect."
        },
        "nanoc.tuiPath": {
          "type": "string",
          "default": "",
          "description": "Path to the nanoc-tui executable. Leave empty to auto-detect."
        }
      }
    },
    "languages": [
      {
        "id": "nanoc",
        "aliases": ["NanoC", "nanoc"],
        "extensions": [".nanoc", ".nc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nanoc",
        "scopeName": "source.nanoc",
        "path": "./syntaxes/nanoc.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "nanoc",
        "label": "NanoC",
        "languages": ["nanoc"],
        "configurationAttributes": {
          "attach": {
            "required": [],
            "properties": {
              "host": { "type": "string", "default": "127.0.0.1", "description": "NanoC bridge host" },
              "port": { "type": "number", "default": 41100, "description": "NanoC bridge port" },
              "token": { "type": "string", "default": "", "description": "Controller external token" },
              "source": { "type": "string", "description": "Path to the matching .nanoc source file (used for stack traces)" },
              "program": { "type": "string", "description": "Path to the .nanoc file to upload on start (use ${file})" },
              "upload": { "type": "boolean", "default": false, "description": "Upload 'program' before starting" },
              "terminalInConsole": { "type": "boolean", "default": false, "description": "Also mirror program output into the Debug Console (normally use the NanoC terminal instead)" }
            }
          },
          "launch": {
            "required": [],
            "properties": {
              "host": { "type": "string", "default": "127.0.0.1" },
              "port": { "type": "number", "default": 41100 },
              "token": { "type": "string", "default": "" },
              "source": { "type": "string" },
              "program": { "type": "string" },
              "upload": { "type": "boolean", "default": false },
              "terminalInConsole": { "type": "boolean", "default": false, "description": "Also mirror program output into the Debug Console" }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nanoc",
            "request": "attach",
            "name": "NanoC: attach + run active file",
            "host": "127.0.0.1",
            "port": 41100,
            "token": "",
            "source": "${file}",
            "program": "${file}",
            "upload": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "NanoC: attach + run active file",
            "description": "Attach to a NanoC controller and upload the active .nanoc file",
            "body": {
              "type": "nanoc",
              "request": "attach",
              "name": "NanoC: attach",
              "host": "127.0.0.1",
              "port": 41100,
              "token": "${1:token}",
              "source": "${2:${file}}",
              "program": "${2:${file}}",
              "upload": true
            }
          }
        ]
      }
    ]
  }
}
