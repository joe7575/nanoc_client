// NanoC example: signal tower cycler
//
// Cycles a TA4 Signal Tower through green -> amber -> red and shows the
// current colour on the terminal, on a fixed row.
//
// Setup:
//   1. Place a NanoC controller. A termlib terminal is optional; the external
//      `nanoc-tui` shows the controller output without one.
//   2. Set TOWER below to the tower's node number. Look at the tower in game:
//      every Techage block shows its number in the infotext, e.g.
//      "TA4 Signal Tower 6845". Do not guess the number.
//   3. Upload with VS Code (F5) or `nanoc exec signal_tower.nanoc
//      --token <TOKEN>`, then start it.
//
// Colour note:
//   The ESC 8 colour escapes are understood by `nanoc-tui` and other ANSI
//   terminals. The in-game termlib terminal prints them literally.

const TOWER = 1234        // node number of the signal tower
const ROW = 3             // terminal row for the status line (1..20)

int32 p[1]                // payload array: ta_send_cmd needs a reference
int32 fg[4] = {0, 2, 3, 1} // ANSI: 1 = red, 2 = green, 3 = yellow
int32 color = 1           // 1 = green, 2 = amber, 3 = red

func color_output(int32 color) {
    printf("\27%c%c", 2, ROW)
    printf("\27%c%c", 8, fg[color])   // ESC 8 <fg>
    printf("tower %d  color %d/3", TOWER, color)
    printf("\27%c%c", 8, 7)           // ESC 8 7: white
    printf("\n")
}

printf("\27\1")           // clear the screen once
printf("NanoC signal tower demo\n")

while (1) {
    p[0] = color
    ta_send_cmd(TOWER, 2, p)

    // Status line on a fixed row.
    color_output(color)
    color = ((color + 1) % 3) + 1

    sleep(1000)
}
